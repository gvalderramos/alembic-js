{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "type": "refactor", "release": "patch" },
          { "type": "build", "release": "patch" },
          { "type": "ci", "release": "patch" },
          { "type": "chore", "release": "patch" },
          { "type": "docs", "release": "patch" },
          { "type": "style", "release": "patch" },
          { "type": "test", "release": "patch" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "node scripts/ci/check-version.js ${nextRelease.version}",
        "prepareCmd": "node scripts/ci/stamp-tarball.js ci/alembic-js-0.0.0-ci.tgz ${nextRelease.version} dist",
        "publishCmd": "npm publish dist/alembic-js-${nextRelease.version}.tgz --access public --provenance"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/*.tgz", "label": "npm package (prebuilt for 8 platforms)" },
          { "path": "dist/SHA256SUMS", "label": "SHA-256 checksums" }
        ]
      }
    ]
  ]
}
